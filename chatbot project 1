print("Hello! I'm SmartBot.")
print("I can chat with you and perform basic calculations.")
print("Type 'help' to see what I can do.")
print("Type 'bye' to end the conversation.")

print("-" * 55)
while True:

    # Take input from the user
    user_input = input("You: ")

    # Clean the input
    user_input = user_input.lower().strip()
    if not user_input:

        print("Bot: Please type something.")
        continue
    if user_input in ["bye", "exit", "quit", "goodbye"]:

        print("Bot: Goodbye! Have a great day!")
        break
    elif user_input in [
        "date",
        "today",
        "what is the date"
    ]:

        current_date = datetime.now().strftime("%d-%m-%Y")

        print("Bot: Today's date is", current_date)
    elif user_input in [
        "time",
        "current time",
        "what time is it"
    ]:

        current_time = datetime.now().strftime("%I:%M:%S %p")

        print("Bot: The current time is", current_time)
    elif user_input.startswith("add"):

        try:

            numbers = list(
                map(float, user_input.split()[1:])
            )

            if len(numbers) < 2:

                print("Bot: Please provide at least two numbers.")

            else:

                result = sum(numbers)

                print("Bot: The result is", result)

        except ValueError:

            print("Bot: Please enter valid numbers.")
    elif user_input.startswith("subtract"):

        try:

            numbers = list(
                map(float, user_input.split()[1:])
            )

            if len(numbers) < 2:

                print("Bot: Please provide at least two numbers.")

            else:

                result = numbers[0]

                for number in numbers[1:]:

                    result -= number

                print("Bot: The result is", result)

        except ValueError:

            print("Bot: Please enter valid numbers.")
    elif user_input.startswith("multiply"):

        try:

            numbers = list(
                map(float, user_input.split()[1:])
            )

            if len(numbers) < 2:

                print("Bot: Please provide at least two numbers.")

            else:

                result = 1

                for number in numbers:

                    result *= number

                print("Bot: The result is", result)

        except ValueError:

            print("Bot: Please enter valid numbers.")
    elif user_input.startswith("divide"):

        try:

            numbers = list(
                map(float, user_input.split()[1:])
            )

            if len(numbers) < 2:

                print("Bot: Please provide at least two numbers.")

            else:

                result = numbers[0]

                for number in numbers[1:]:

                    if number == 0:

                        print("Bot: Division by zero is not allowed.")
                        break

                    result /= number

                else:

                    print("Bot: The result is", result)

        except ValueError:

            print("Bot: Please enter valid numbers.")
    else:

        response = responses.get(user_input)

        if response:

            print("Bot:", response)

        else:

            print("Bot: I'm sorry, I don't understand that.")
            print("Bot: Type 'help' to see what I can do.")
